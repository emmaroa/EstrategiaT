<body class="dashboard-body portal-proveedor-body">
  <aside class="sidebar">
    <div class="sidebar-logo">
      <div class="mini-logo">E</div>
      <div>
        <h3>Administración de Talleres</h3>
        <small id="etModuleName">Portal Proveedor</small>
      </div>
    </div>
    <nav id="etNav"></nav>
    <button type="button" class="logout" id="etLogout">Cerrar sesión</button>
  </aside>

  <main class="main-content">
    <header class="topbar">
      <div>
        <h1 id="tituloPortalProveedor">Portal de proveedores</h1>
        <p id="nombreProveedorPortal">Consulta tus solicitudes y requisiciones asignadas.</p>
      </div>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <label id="selectorProveedorPortalGrupo" style="display:none;align-items:center;gap:8px;font-weight:700;">
          Proveedor
          <select id="selectorProveedorPortal" aria-label="Seleccionar proveedor activo"></select>
        </label>
        <span id="etTemaContainer"></span>
      </div>
    </header>

    <section class="portal-welcome" id="guiaPortalProveedor" aria-labelledby="tituloGuiaPortal">
      <h2 id="tituloGuiaPortal">¿Qué necesitas hacer hoy?</h2>
      <p>Empieza por tus pendientes. También puedes consultar el avance de un trámite cuando lo necesites.</p>
      <div class="portal-next-actions">
        <a class="portal-next-action" href="portal-proveedor.html?vista=peticiones" id="accesoEntregasPendientes">
          <span class="portal-action-count is-warning" id="resumenPendientesEntrega">0</span>
          <span><strong>Confirmar entregas</strong><small>Revisa materiales que todavía aparecen pendientes.</small></span>
        </a>
        <a class="portal-next-action" href="portal-proveedor.html?vista=cotizaciones">
          <span class="portal-action-count" id="resumenCotizacionesPendientes">0</span>
          <span><strong>Gestionar cotizaciones</strong><small>Registra una entrega o revisa tus cotizaciones.</small></span>
        </a>
        <a class="portal-next-action" href="portal-proveedor.html?vista=seguimiento-siif">
          <span class="portal-action-count" id="resumenTramitesActivos">0</span>
          <span><strong>Consultar trámites</strong><small>Consulta requisición, orden de compra y pago.</small></span>
        </a>
      </div>
    </section>

    <section class="kpi-grid" id="kpisPortalGeneral" aria-label="Indicadores principales del proveedor">
      <div class="kpi-card portal-kpi is-warning"><div class="portal-kpi-head"><span>Entregas pendientes</span><span class="portal-kpi-icon"><svg viewBox="0 0 24 24"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span></div><h2 id="kpiPendientesProveedor">0</h2><p>Requieren tu confirmación</p></div>
      <div class="kpi-card portal-kpi is-success"><div class="portal-kpi-head"><span>Entregas confirmadas</span><span class="portal-kpi-icon"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></span></div><h2 id="kpiEntregadasProveedor">0</h2><p>Material recibido por almacén</p></div>
      <div class="kpi-card portal-kpi is-warning"><div class="portal-kpi-head"><span>Cotizaciones por revisar</span><span class="portal-kpi-icon"><svg viewBox="0 0 24 24"><path d="M5 3h14v18H5zM8 8h8M8 12h6"/></svg></span></div><h2 id="kpiCotizacionesPendientesDashboard">0</h2><p>Pendientes de validación interna</p></div>
      <div class="kpi-card portal-kpi"><div class="portal-kpi-head"><span>Trámites activos</span><span class="portal-kpi-icon"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="8" cy="6" r="2"/></svg></span></div><h2 id="kpiRequisicionesProveedor">0</h2><p>Sin incluir cancelados</p></div>
      <div class="kpi-card portal-kpi is-money"><div class="portal-kpi-head"><span>Cartera activa SIIF</span><span class="portal-kpi-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M15 8h-4a2 2 0 0 0 0 4h2a2 2 0 0 1 0 4H9M12 6v12"/></svg></span></div><h2 id="kpiMontoSiifProveedor">$0.00</h2><p>Importe activo, sin cancelados</p></div>
      <div class="kpi-card portal-kpi is-process"><div class="portal-kpi-head"><span>Con orden de compra</span><span class="portal-kpi-icon"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM8 9h8M8 13h5"/></svg></span></div><h2 id="kpiOrdenesCompraProveedor">0</h2><p>Trámites que ya tienen OC</p></div>
      <div class="kpi-card portal-kpi is-success"><div class="portal-kpi-head"><span>En proceso de pago</span><span class="portal-kpi-icon"><svg viewBox="0 0 24 24"><path d="M4 7h16v10H4zM8 12h8"/></svg></span></div><h2 id="kpiSolicitudesPagoProveedor">0</h2><p>Con solicitud de pago generada</p></div>
      <div class="kpi-card portal-kpi"><div class="portal-kpi-head"><span>Total de peticiones</span><span class="portal-kpi-icon"><svg viewBox="0 0 24 24"><path d="M6 3h9l3 3v15H6zM15 3v4h4M9 12h6M9 16h6"/></svg></span></div><h2 id="kpiPeticionesProveedor">0</h2><p>Histórico asignado visible</p></div>
    </section>

    <section class="kpi-grid" id="kpisCotizaciones" aria-label="Indicadores de cotizaciones">
      <div class="kpi-card"><span>Total de cotizaciones</span><h2 id="kpiCotizacionesAlmacen">0</h2><p>Registros privados del proveedor</p></div>
      <div class="kpi-card"><span>Sin trámite</span><h2 id="kpiCotizacionesSinTramite">0</h2><p>Sin requisición asignada</p></div>
      <div class="kpi-card"><span>Con requisición</span><h2 id="kpiCotizacionesConTramite">0</h2><p>Vinculadas a un trámite</p></div>
      <div class="kpi-card"><span>Requisiciones por cotizar</span><h2 id="kpiCotizacionesPendientesPortalCompras">0</h2><p>Cotizaciones con requisición pendientes en portal de compras</p></div>
      <div class="kpi-card"><span>Pendientes de revisión</span><h2 id="kpiCotizacionesPendientes">0</h2><p>Requieren atención</p></div>
      <div class="kpi-card"><span>Monto sin trámite</span><h2 id="kpiTotalCotizacionesSinTramite">$0.00</h2><p>Importe sin requisición</p></div>
      <div class="kpi-card"><span>Monto con requisición</span><h2 id="kpiTotalCotizacionesConTramite">$0.00</h2><p>Importe vinculado a requisiciones</p></div>
    </section>

    <section class="panel portal-module" id="moduloResumenSiif">
      <div class="panel-header">
        <div>
          <h2>Resumen de trámites SIIF</h2>
          <p>Cantidad y monto acumulado por grupo de seguimiento.</p>
          <span class="portal-siif-updated" id="fechaActualizacionSiifProveedor">Consultando actualización de SIIF…</span>
        </div>
      </div>
      <div class="portal-status-grid" id="resumenEstatusSiifProveedor"></div>
    </section>

    <section class="panel portal-module" id="moduloPeticiones">
      <div class="panel-header">
        <div>
          <h2>Peticiones asignadas</h2>
          <p>Confirma la entrega al almacén o agrega una nota especial.</p>
        </div>
        <button type="button" class="btn-secondary" id="btnExportarPeticionesProveedor">Exportar hoja de cálculo</button>
      </div>
      <div class="filters">
        <input type="search" id="buscarPeticionesProveedor" placeholder="Buscar por unidad, petición, solicitante o nota..." aria-label="Buscar peticiones">
        <select id="filtroEstatusPeticionProveedor" aria-label="Filtrar peticiones por estatus interno">
          <option value="">Todos los estatus</option>
        </select>
        <select id="filtroEntregaPeticionProveedor" aria-label="Filtrar peticiones por entrega">
          <option value="">Todas las entregas</option>
          <option value="pendiente">Pendientes de entrega</option>
          <option value="entregada">Entregadas al almacén</option>
        </select>
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Pedido</th>
              <th>Entrega</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="tablaPeticionesProveedor"></tbody>
        </table>
      </div>
    </section>

    <section class="panel portal-module" id="moduloCotizaciones">
      <div class="panel-header">
        <div>
          <h2>Cotizaciones</h2>
          <p>Consulta y administra las cotizaciones registradas por el proveedor.</p>
        </div>
        <button type="button" class="btn-secondary" id="btnExportarCotizaciones">Exportar datos</button>
        <button type="button" class="btn-small" id="btnNuevaCotizacionAlmacen">Agregar nueva cotización</button>
      </div>
      <div class="filters">
        <input type="search" id="buscarCotizacionesAlmacen" placeholder="Buscar por requisición, folio, unidad, material, monto o notas..." aria-label="Buscar cotizaciones por requisición, folio, unidad, material, monto o notas">
        <select id="filtroEstatusCotizacionesAlmacen" aria-label="Filtrar cotizaciones por estatus">
          <option value="">Todos los estatus</option>
        </select>
        <label>Desde <input type="date" id="fechaDesdeCotizacionesAlmacen" aria-label="Cotizaciones desde"></label>
        <label>Hasta <input type="date" id="fechaHastaCotizacionesAlmacen" aria-label="Cotizaciones hasta"></label>
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Folio</th>
              <th>Fecha entrega</th>
              <th>Unidad</th>
              <th>Requisición</th>
              <th>Materiales</th>
              <th>Total</th>
              <th>Estatus</th>
              <th>Notas</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="tablaCotizacionesAlmacen"></tbody>
        </table>
      </div>
    </section>

    <section class="panel portal-module" id="moduloSeguimientoSiif">
      <div class="panel-header">
        <div>
          <h2>Detalle de trámites SIIF</h2>
          <p>Seguimiento exclusivo de las requisiciones vinculadas con tu proveedor activo.</p>
        </div>
        <button type="button" class="btn-secondary" id="btnExportarRequisicionesProveedor">Exportar hoja de cálculo</button>
      </div>
      <div class="filters">
        <input type="search" id="buscarRequisicionesProveedor" placeholder="Buscar por requisición, unidad, concepto u orden de compra..." aria-label="Buscar requisiciones">
        <select id="filtroEstatusRequisicionProveedor" aria-label="Filtrar requisiciones por estatus">
          <option value="">Todos los estatus</option>
        </select>
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Requisición</th>
              <th>Concepto</th>
              <th>Monto</th>
              <th>Etapa</th>
              <th>Estatus</th>
              <th>Detalle</th>
            </tr>
          </thead>
          <tbody id="tablaRequisicionesProveedor"></tbody>
        </table>
      </div>
    </section>
