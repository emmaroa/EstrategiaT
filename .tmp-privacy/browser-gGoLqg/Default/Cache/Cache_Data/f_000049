<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <title>Administración de Talleres | Portal Proveedor</title>
  <link rel="stylesheet" href="../css/style.css">
  <link rel="stylesheet" href="../css/design-system.css?v=20260819-14">
  <style>
    .portal-status-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px; }
    .portal-status-card { --portal-status-accent:var(--color-info, #3b82f6); padding:16px; border:1px solid var(--border-subtle, #e5e7eb); border-radius:14px; background:var(--bg-card, #fff); }
    .portal-status-card.is-success { --portal-status-accent:var(--color-success, #22c55e); }
    .portal-status-card.is-cancelled { --portal-status-accent:var(--color-danger, #ef4444); }
    .portal-status-card.is-warning { --portal-status-accent:var(--color-warning, #f59e0b); }
    .portal-status-card h3 { margin:0 0 12px; font-size:0.95rem; }
    .portal-status-values { display:flex; justify-content:space-between; gap:12px; align-items:flex-end; }
    .portal-status-values strong { font-size:1.35rem; }
    .portal-status-values span { color:var(--text-secondary, #475569); font-weight:700; text-align:right; }
    .portal-status-track { height:7px; margin-top:12px; overflow:hidden; border-radius:999px; background:color-mix(in srgb, var(--portal-status-accent) 18%, transparent); }
    .portal-status-bar { height:100%; border-radius:inherit; background:var(--portal-status-accent); }
    [data-theme="dark"] .portal-proveedor-body .portal-status-card {
      background:linear-gradient(145deg, color-mix(in srgb, var(--portal-status-accent) 15%, #111827), #0f172a 76%);
      border-color:color-mix(in srgb, var(--portal-status-accent) 45%, #334155);
      box-shadow:0 10px 24px rgba(0, 0, 0, .25);
    }
    [data-theme="dark"] .portal-proveedor-body .portal-status-card h3 { color:color-mix(in srgb, var(--portal-status-accent) 82%, white); }
    [data-theme="dark"] .portal-proveedor-body .portal-status-values strong { color:#f8fafc; }
    [data-theme="dark"] .portal-proveedor-body .portal-status-values span { color:#e2e8f0; }
    .portal-module { scroll-margin-top:20px; }
    .portal-module.is-collapsed > :not(.panel-header) { display:none; }
    .portal-module-actions { display:flex; align-items:center; justify-content:flex-end; gap:8px; flex-wrap:wrap; }
    .portal-collapse-button { min-width:42px; padding-inline:12px; font-size:18px; line-height:1; }
    .portal-module.is-collapsed .portal-collapse-button { transform:rotate(-90deg); }
    .portal-siif-updated { display:inline-flex; margin-top:9px; padding:6px 10px; border:1px solid color-mix(in srgb, var(--color-info) 35%, var(--border-subtle)); border-radius:999px; background:color-mix(in srgb, var(--color-info) 10%, transparent); color:var(--text-secondary); font-size:12px; font-weight:700; }
    #kpisCotizaciones, #moduloCotizaciones, #moduloResumenSiif, #moduloPeticiones, #moduloSeguimientoSiif { display:none; }
    .portal-peticiones-view #guiaPortalProveedor,
    .portal-peticiones-view #kpisPortalGeneral,
    .portal-cotizaciones-view #guiaPortalProveedor,
    .portal-cotizaciones-view #kpisPortalGeneral,
    .portal-siif-view #guiaPortalProveedor,
    .portal-siif-view #kpisPortalGeneral,
    .portal-peticiones-view .portal-dashboard-only,
    .portal-cotizaciones-view .portal-dashboard-only,
    .portal-siif-view .portal-dashboard-only { display:none; }
    .portal-peticiones-view #moduloPeticiones { display:block; }
    .portal-cotizaciones-view #moduloCotizaciones { display:block; }
    .portal-dashboard-view #kpisCotizaciones { display:grid; }
    .portal-siif-view #moduloResumenSiif,
    .portal-siif-view #moduloSeguimientoSiif { display:block; }
    .portal-welcome { margin-bottom:18px; padding:20px; border:1px solid color-mix(in srgb, var(--color-info, #3b82f6) 28%, var(--border-subtle, #e5e7eb)); border-radius:18px; background:linear-gradient(135deg, color-mix(in srgb, var(--color-info, #3b82f6) 10%, var(--bg-card, #fff)), var(--bg-card, #fff)); }
    .portal-welcome h2 { margin:0 0 5px; font-size:1.15rem; }
    .portal-welcome > p { margin:0; color:var(--text-secondary, #475569); }
    .portal-next-actions { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:12px; margin-top:16px; }
    .portal-next-action { display:flex; align-items:center; gap:12px; min-height:74px; padding:13px 15px; border:1px solid var(--border-subtle, #e5e7eb); border-radius:14px; background:var(--bg-card, #fff); color:var(--text-primary, #0f172a); text-align:left; text-decoration:none; cursor:pointer; }
    .portal-next-action:hover { border-color:var(--color-info, #3b82f6); transform:translateY(-1px); }
    .portal-next-action strong { display:block; margin-bottom:3px; }
    .portal-next-action small { display:block; color:var(--text-secondary, #64748b); line-height:1.3; }
    .portal-action-count { display:grid; flex:0 0 38px; width:38px; height:38px; place-items:center; border-radius:12px; background:color-mix(in srgb, var(--color-info, #3b82f6) 14%, transparent); color:var(--color-info, #2563eb); font-size:1.05rem; font-weight:800; }
    .portal-action-count.is-warning { background:color-mix(in srgb, var(--color-warning, #f59e0b) 16%, transparent); color:#b45309; }
    .portal-petition-actions { display:flex; align-items:center; justify-content:flex-end; gap:8px; min-width:285px; }
    .portal-action-button { display:inline-flex; align-items:center; justify-content:center; gap:7px; min-height:38px; padding:8px 12px; border-radius:10px; font-size:.84rem; font-weight:750; line-height:1; white-space:nowrap; transition:border-color .16s ease, background .16s ease, box-shadow .16s ease, transform .16s ease; }
    .portal-action-button svg { width:17px; height:17px; fill:none; stroke:currentColor; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; }
    .portal-action-button:hover:not(:disabled) { transform:translateY(-1px); }
    .portal-action-button.is-detail { border:1px solid var(--border-subtle, #cbd5e1); background:var(--bg-card, #fff); color:var(--text-primary, #334155); }
    .portal-action-button.is-detail:hover { border-color:var(--color-info, #3b82f6); color:var(--color-info, #2563eb); box-shadow:0 4px 12px color-mix(in srgb, var(--color-info, #3b82f6) 12%, transparent); }
    .portal-action-button.is-confirm { border:1px solid #15803d; background:#15803d; color:#fff; box-shadow:0 4px 12px rgba(21, 128, 61, .18); }
    .portal-action-button.is-confirm:hover:not(:disabled) { background:#166534; border-color:#166534; box-shadow:0 6px 16px rgba(21, 128, 61, .25); }
    .portal-action-button.is-complete { border:1px solid color-mix(in srgb, var(--color-success, #22c55e) 35%, transparent); background:color-mix(in srgb, var(--color-success, #22c55e) 12%, transparent); color:#15803d; box-shadow:none; cursor:default; opacity:1; }
    .portal-quote-actions { display:flex; align-items:center; justify-content:flex-end; gap:7px; min-width:310px; }
    .portal-table-materials { min-width:180px; max-width:260px; line-height:1.35; }
    .portal-table-notes { width:160px; max-width:160px; }
    .portal-table-clamp { display:-webkit-box; overflow:hidden; -webkit-box-orient:vertical; -webkit-line-clamp:2; line-clamp:2; overflow-wrap:anywhere; color:var(--text-secondary, #475569); line-height:1.35; }
    .portal-unit-detail { max-width:620px; margin:7px 0 0; color:var(--text-secondary, #475569); font-size:.82rem; line-height:1.45; }
    .portal-action-button.is-edit { border:1px solid color-mix(in srgb, var(--color-info, #3b82f6) 45%, var(--border-subtle, #cbd5e1)); background:color-mix(in srgb, var(--color-info, #3b82f6) 9%, var(--bg-card, #fff)); color:var(--color-info, #2563eb); }
    .portal-action-button.is-edit:hover:not(:disabled) { border-color:var(--color-info, #2563eb); background:color-mix(in srgb, var(--color-info, #3b82f6) 15%, var(--bg-card, #fff)); }
    .portal-action-button.is-print { border:1px solid var(--border-subtle, #cbd5e1); background:transparent; color:var(--text-secondary, #475569); }
    .portal-action-button.is-print:hover { background:color-mix(in srgb, var(--text-secondary, #64748b) 8%, transparent); color:var(--text-primary, #0f172a); }
    .portal-action-button.is-locked { border:1px solid var(--border-subtle, #e2e8f0); background:color-mix(in srgb, var(--text-secondary, #64748b) 7%, transparent); color:var(--text-secondary, #64748b); cursor:not-allowed; opacity:.75; }
    .portal-section-kicker { margin:0 0 4px; color:var(--color-info, #2563eb); font-size:.75rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; }
    .portal-proveedor-body #kpisPortalGeneral { grid-template-columns:repeat(4, minmax(160px, 1fr)); }
    .portal-kpi { position:relative; overflow:hidden; min-height:142px; padding:18px; border-top:3px solid var(--portal-kpi-color, #3b82f6); }
    .portal-kpi::after { content:""; position:absolute; top:-32px; right:-28px; width:105px; height:105px; border-radius:50%; background:color-mix(in srgb, var(--portal-kpi-color, #3b82f6) 11%, transparent); }
    .portal-kpi-head { position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between; gap:10px; }
    .portal-kpi-icon { display:grid; width:38px; height:38px; place-items:center; border-radius:11px; background:color-mix(in srgb, var(--portal-kpi-color, #3b82f6) 13%, transparent); color:var(--portal-kpi-color, #2563eb); }
    .portal-kpi-icon svg { width:20px; height:20px; fill:none; stroke:currentColor; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; }
    .portal-kpi h2 { position:relative; z-index:1; margin:13px 0 4px; font-size:1.75rem; }
    .portal-kpi p { position:relative; z-index:1; margin:0; }
    .portal-kpi.is-warning { --portal-kpi-color:#f59e0b; }
    .portal-kpi.is-success { --portal-kpi-color:#16a34a; }
    .portal-kpi.is-money { --portal-kpi-color:#0f766e; }
    .portal-kpi.is-process { --portal-kpi-color:#7c3aed; }
    @media (max-width:900px) {
      .portal-next-actions { grid-template-columns:1fr; }
      .portal-proveedor-body #kpisPortalGeneral { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width:560px) {
      .portal-proveedor-body #kpisPortalGeneral { grid-template-columns:1fr 1fr; }
      .portal-welcome { padding:16px; }
      .portal-petition-actions { min-width:0; flex-direction:column; align-items:stretch; }
      .portal-quote-actions { min-width:0; flex-direction:column; align-items:stretch; }
      .portal-action-button { width:100%; }
    }
  </style>
  
  
  
  
  
  
  
