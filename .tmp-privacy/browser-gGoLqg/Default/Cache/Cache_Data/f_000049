  <div class="modal" id="modalNotaProveedor" role="dialog" aria-modal="true" aria-labelledby="tituloNotaProveedor" aria-hidden="true">
    <div class="modal-card">
      <div class="modal-header">
        <div>
          <h2 id="tituloNotaProveedor">Nota especial</h2>
          <p>La nota quedará asociada a esta petición.</p>
        </div>
        <button type="button" class="close-btn" aria-label="Cerrar diálogo">×</button>
      </div>
      <div class="input-group">
        <label for="textoNotaProveedor">Nota del proveedor</label>
        <textarea id="textoNotaProveedor" rows="6" maxlength="2000" placeholder="Escribe indicaciones, incidencias o detalles de la entrega"></textarea>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-secondary">Cancelar</button>
        <button data-privacy-submit type="button" class="btn-small">Guardar nota</button>
      </div>
    </div>
  </div>

  <div class="modal" id="modalCotizacionAlmacen" role="dialog" aria-modal="true" aria-labelledby="tituloCotizacionAlmacen" aria-hidden="true">
    <div class="modal-card">
      <div class="modal-header">
        <div>
          <h2 id="tituloCotizacionAlmacen">Registrar entrega sin petición</h2>
          <p>Captura los datos de lo entregado al almacén.</p>
        </div>
        <button type="button" class="close-btn" aria-label="Cerrar diálogo">×</button>
      </div>
      <div class="form-grid">
        <div class="input-group">
          <label for="cotizacionFechaCotizacion">Fecha de cotización</label>
          <input type="date" id="cotizacionFechaCotizacion" readonly>
        </div>
        <div class="input-group">
          <label for="cotizacionFechaEntrega">Fecha de entrega</label>
          <input type="date" id="cotizacionFechaEntrega" required>
        </div>
        <div class="input-group">
          <label for="cotizacionUnidad">Número de inventario</label>
          <input type="text" id="cotizacionUnidad" maxlength="100" placeholder="Inventario completo, últimos 4 dígitos, 0 o STOCK" required>
          <small id="cotizacionInfoUnidad">Captura el inventario completo o sus últimos 4 dígitos.</small>
        </div>
        <div class="input-group">
          <label for="cotizacionDependencia">Dependencia</label>
          <input type="text" id="cotizacionDependencia" readonly placeholder="Pendiente">
        </div>
        <div class="input-group full">
          <div class="panel-header">
            <div>
              <label>Material entregado</label>
              <small>Agrega uno o varios artículos.</small>
            </div>
            <button type="button" class="btn-secondary" id="btnAgregarMaterialCotizacion">Agregar material</button>
          </div>
          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th>Cantidad</th>
                  <th>Artículo</th>
                  <th>Precio unitario</th>
                  <th>Importe</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="materialesCotizacionAlmacen"></tbody>
            </table>
          </div>
          <div style="display:flex;justify-content:flex-end;margin-top:12px;">
            <div style="min-width:260px;display:grid;grid-template-columns:1fr auto;gap:8px 20px;">
              <span>Subtotal</span><strong id="cotizacionSubtotal">$0.00</strong>
              <span>IVA (16%)</span><strong id="cotizacionIVA">$0.00</strong>
              <span>Total</span><strong id="cotizacionTotal">$0.00</strong>
            </div>
          </div>
        </div>
        <div class="input-group full">
          <label for="cotizacionObservaciones">Notas / observaciones</label>
          <textarea id="cotizacionObservaciones" rows="3" maxlength="2000" placeholder="Agrega notas, indicaciones o detalles de esta cotización"></textarea>
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-secondary">Cancelar</button>
        <button data-privacy-submit type="button" class="btn-small" id="btnGuardarCotizacionAlmacen">Guardar registro</button>
      </div>
    </div>
  </div>

  
