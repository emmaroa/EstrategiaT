<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Administración de Talleres | Peticiones</title>
  <link rel="stylesheet" href="../css/style.css">
  <link rel="stylesheet" href="../css/design-system.css?v=20260824-2">
  <style>
    .peticion-copiar-directo { display:block; margin-top:8px; min-height:44px; padding:8px 12px; }
    .peticion-texto-copia { width:min(560px, calc(100% - 32px)); padding:20px; border:1px solid var(--border-color, #888); border-radius:12px; background:var(--bg-card, white); color:var(--text-primary, #17212b); }
    .peticion-texto-copia textarea { width:100%; box-sizing:border-box; min-height:180px; margin:12px 0; font-size:16px; }
    .peticion-texto-copia::backdrop { background:#0009; }
    #kpisGestionCotizaciones { display:none; }
    #graficaMontoProveedorCotizaciones { display:none; }
    .gestion-cotizaciones-view #kpisPeticiones,
    .gestion-cotizaciones-view #panelListadoPeticiones,
    .gestion-cotizaciones-view #btnNuevaPeticion { display:none; }
    .gestion-cotizaciones-view #kpisGestionCotizaciones { display:grid; }
    .gestion-cotizaciones-view #graficaMontoProveedorCotizaciones { display:block; }
    .cotizaciones-provider-chart { display:grid; gap:12px; margin-top:16px; }
    .cotizaciones-provider-row { display:grid; grid-template-columns:minmax(130px, 220px) minmax(180px, 1fr) auto; gap:12px; align-items:center; }
    .cotizaciones-provider-name { overflow:hidden; color:var(--text-secondary); font-size:13px; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
    .cotizaciones-provider-track { height:12px; overflow:hidden; border-radius:999px; background:color-mix(in srgb, var(--color-teal) 14%, var(--bg-card)); }
    .cotizaciones-provider-bar { height:100%; min-width:3px; border-radius:inherit; background:linear-gradient(90deg, var(--color-teal), var(--color-info)); }
    .cotizaciones-provider-amount { color:var(--text-primary); font-size:13px; font-weight:800; text-align:right; }
    .cotizaciones-materials-cell { min-width:240px; max-width:360px; white-space:normal; }
    .cotizaciones-materials-list { display:grid; gap:4px; margin:0; padding-left:18px; }
    .cotizaciones-materials-list li { line-height:1.35; }
    #tablaGestionCotizaciones tr.cotizacion-clickable { cursor:pointer; }
    #tablaGestionCotizaciones tr.cotizacion-clickable:focus-visible { outline:3px solid color-mix(in srgb, var(--color-teal) 55%, transparent); outline-offset:-3px; }
    #tablaGestionCotizaciones tr.cotizacion-sin-requisicion { background:color-mix(in srgb, var(--color-warning) 9%, transparent); box-shadow:inset 4px 0 0 var(--color-warning); }
    #tablaGestionCotizaciones tr.cotizacion-sin-requisicion:hover { background:color-mix(in srgb, var(--color-warning) 15%, var(--bg-card)); }
    .cotizacion-pendiente-badge { display:inline-flex; align-items:center; padding:5px 9px; border:1px solid color-mix(in srgb, var(--color-warning) 45%, transparent); border-radius:999px; background:color-mix(in srgb, var(--color-warning) 14%, transparent); color:var(--text-primary); font-size:11px; font-weight:850; white-space:nowrap; }
    .cotizacion-preview-card { width:min(1040px, calc(100vw - 28px)); height:min(90vh, 860px); padding:0; overflow:hidden; }
    .cotizacion-preview-header { padding:18px 22px 14px; border-bottom:1px solid var(--border); }
    .cotizacion-preview-frame { display:block; width:100%; height:calc(90vh - 158px); min-height:440px; border:0; background:#fff; }
    .cotizacion-preview-actions { padding:14px 22px; border-top:1px solid var(--border); background:var(--bg-card); }
    #tablaPeticiones tr.peticion-fila { cursor:pointer; }
    #tablaPeticiones tr.peticion-fila:focus-visible { outline:2px solid var(--color-teal); outline-offset:-2px; }
    .peticion-view-note { position:relative; width:36px; height:36px; }
    .peticion-view-note .action-btn { margin:0; }
    .peticion-note-indicator { position:absolute; top:-5px; right:-5px; display:flex; align-items:center; justify-content:center; width:17px; height:17px; border:2px solid var(--bg-card); border-radius:50%; background:var(--color-warning); color:#111827; pointer-events:none; z-index:1; }
    .peticion-note-indicator svg { width:9px; height:9px; fill:none; stroke:currentColor; stroke-width:2; }
    .status-badge.peticion-status { gap:7px; max-width:190px; padding:6px 11px; border-width:1px; border-style:solid; box-shadow:inset 0 1px 0 rgba(255,255,255,.06); font-weight:850; }
    .status-badge.peticion-status::before { width:7px; height:7px; flex-basis:7px; box-shadow:0 0 0 3px color-mix(in srgb, currentColor 16%, transparent); }
    .status-badge.peticion-status--pendiente { color:#fbbf24 !important; border-color:rgba(245,158,11,.30) !important; background:rgba(245,158,11,.13) !important; }
    .status-badge.peticion-status--revisado { color:#60a5fa !important; border-color:rgba(59,130,246,.30) !important; background:rgba(59,130,246,.13) !important; }
    .status-badge.peticion-status--cotizacion { color:#c084fc !important; border-color:rgba(168,85,247,.30) !important; background:rgba(168,85,247,.13) !important; }
    .status-badge.peticion-status--pedido { color:#22d3ee !important; border-color:rgba(6,182,212,.30) !important; background:rgba(6,182,212,.13) !important; }
    .status-badge.peticion-status--parcial { color:#fb923c !important; border-color:rgba(249,115,22,.30) !important; background:rgba(249,115,22,.13) !important; }
    .status-badge.peticion-status--recibido { color:#4ade80 !important; border-color:rgba(34,197,94,.30) !important; background:rgba(34,197,94,.13) !important; }
    .status-badge.peticion-status--cancelado,
    .status-badge.peticion-status--rechazado { color:#f87171 !important; border-color:rgba(239,68,68,.30) !important; background:rgba(239,68,68,.13) !important; }
    .status-badge.peticion-status--neutral { color:#cbd5e1 !important; border-color:rgba(148,163,184,.28) !important; background:rgba(148,163,184,.12) !important; }
    [data-theme="light"] .status-badge.peticion-status--pendiente { color:#92400e !important; }
    [data-theme="light"] .status-badge.peticion-status--revisado { color:#1d4ed8 !important; }
    [data-theme="light"] .status-badge.peticion-status--cotizacion { color:#7e22ce !important; }
    [data-theme="light"] .status-badge.peticion-status--pedido { color:#0e7490 !important; }
    [data-theme="light"] .status-badge.peticion-status--parcial { color:#c2410c !important; }
    [data-theme="light"] .status-badge.peticion-status--recibido { color:#15803d !important; }
    [data-theme="light"] .status-badge.peticion-status--cancelado,
    [data-theme="light"] .status-badge.peticion-status--rechazado { color:#b91c1c !important; }
    [data-theme="light"] .status-badge.peticion-status--neutral { color:#475569 !important; }
    .historial-modal-card { width:min(620px, calc(100vw - 28px)); max-height:min(78vh, 720px); padding:0; overflow:hidden; }
    .historial-modal-header { padding:22px 24px 16px; border-bottom:1px solid var(--border); background:linear-gradient(135deg, color-mix(in srgb, var(--color-teal) 12%, var(--bg-card)), var(--bg-card)); }
    .historial-modal-header p { margin:5px 0 0; color:var(--text-secondary); }
    .historial-content { max-height:calc(78vh - 100px); padding:20px 24px 24px; overflow-y:auto; }
    .historial-loading, .historial-empty { padding:28px 18px; border:1px dashed var(--border); border-radius:12px; color:var(--text-secondary); text-align:center; }
    .historial-timeline { display:grid; gap:0; margin:0; padding:0; list-style:none; }
    .historial-item { position:relative; display:grid; grid-template-columns:18px minmax(0, 1fr); gap:13px; padding-bottom:18px; }
    .historial-item:not(:last-child)::before { content:""; position:absolute; top:17px; bottom:0; left:7px; width:2px; background:color-mix(in srgb, var(--color-teal) 25%, var(--border)); }
    .historial-dot { position:relative; width:16px; height:16px; margin-top:4px; border:4px solid color-mix(in srgb, var(--color-teal) 22%, var(--bg-card)); border-radius:50%; background:var(--color-teal); z-index:1; }
    .historial-entry { padding:14px 16px; border:1px solid var(--border); border-radius:12px; background:var(--bg-card); box-shadow:0 4px 14px rgba(15, 23, 42, .06); }
    .historial-entry-head { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:8px; }
    .historial-entry-head strong { color:var(--text-primary); }
    .historial-entry-head time { flex:0 0 auto; color:var(--text-secondary); font-size:12px; font-weight:700; }
    .historial-user { display:block; margin-bottom:7px; color:var(--color-teal); font-size:12px; font-weight:800; }
    .historial-detail { margin:0; color:var(--text-secondary); line-height:1.5; white-space:pre-wrap; overflow-wrap:anywhere; }
    .historial-kind { display:inline-flex; align-items:center; margin-bottom:9px; padding:4px 9px; border-radius:999px; font-size:11px; font-weight:900; letter-spacing:.03em; text-transform:uppercase; }
    .historial-kind.added { background:rgba(34, 197, 94, .13); color:#15803d; }
    .historial-kind.changed { background:rgba(245, 158, 11, .15); color:#b45309; }
    .historial-changes { display:grid; gap:8px; margin-top:12px; }
    .historial-change { display:grid; gap:4px; padding:10px 12px; border-radius:9px; background:color-mix(in srgb, var(--color-teal) 6%, var(--bg-card)); }
    .historial-change-label { color:var(--text-primary); font-size:12px; font-weight:900; }
    .historial-change-values { display:flex; flex-wrap:wrap; align-items:center; gap:6px; color:var(--text-secondary); font-size:12px; }
    .historial-old { text-decoration:line-through; opacity:.75; }
    .historial-new { color:var(--text-primary); font-weight:800; }
    .historial-arrow { color:var(--color-teal); font-weight:900; }
    @media(max-width:700px) { .cotizaciones-provider-row { grid-template-columns:1fr auto; } .cotizaciones-provider-track { grid-column:1 / -1; grid-row:2; } }
  </style>
  
  
  
  
  
  
  
  
  
